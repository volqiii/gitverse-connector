# Do not commit a real token. On Windows, prefer scripts/save-token.ps1.
# GITVERSE_TOKEN=

# auto tries the official MCP, then the REST read fallback, then a localhost bridge.
GITVERSE_TRANSPORT=auto

# Bridge is local-only by default. Its session secret is separate from the GitVerse token.
GITVERSE_BRIDGE_URL=http://127.0.0.1:47831
# GITVERSE_BRIDGE_SESSION_SECRET=

# Custom endpoints are blocked unless this is explicitly set to true for development.
GITVERSE_DEVELOPER_MODE=false
